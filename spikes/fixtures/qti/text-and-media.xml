<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0" identifier="cart-speed-media" title="Speed of a rolling cart, from a video and a formula" adaptive="false" time-dependent="false" xml:lang="en-US">
  <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="identifier">
    <qti-correct-response>
      <qti-value>CHOICE_RATIO</qti-value>
    </qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float" normal-minimum="0" normal-maximum="1">
    <qti-default-value>
      <qti-value>0</qti-value>
    </qti-default-value>
  </qti-outcome-declaration>
  <qti-outcome-declaration identifier="MAXSCORE" cardinality="single" base-type="float">
    <qti-default-value>
      <qti-value>1</qti-value>
    </qti-default-value>
  </qti-outcome-declaration>
  <qti-item-body>
    <video controls="controls">
      <source src="https://assets.example/cart-lab/videos/rolling-cart.mp4?rev=4" type="video/mp4"/>
    </video>
    <figure>
      <img src="https://assets.example/cart-lab/images/track-markers.png?rev=3" alt="A straight track marked every half metre."/>
      <figcaption>Average speed: <math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>v</mi><mo>=</mo><mfrac><mi>d</mi><mi>t</mi></mfrac></mrow><annotation encoding="application/x-tex">v = \frac{d}{t}</annotation></semantics></math></figcaption>
    </figure>
    <qti-choice-interaction response-identifier="RESPONSE" shuffle="true" min-choices="1" max-choices="1">
      <qti-prompt>
        <p>The cart's label reads &lt;b&gt;distance&lt;/b&gt; &amp; time.<br/>Which reading of <math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>v</mi><mo>=</mo><mfrac><mi>d</mi><mi>t</mi></mfrac></mrow><annotation encoding="application/x-tex">v = \frac{d}{t}</annotation></semantics></math> fits the video?</p>
        <p>The rule, set apart:<br/><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi>v</mi><mo>=</mo><mfrac><mi>d</mi><mi>t</mi></mfrac></mrow><annotation encoding="application/x-tex">v = \frac{d}{t}</annotation></semantics></math></p>
        <p>
          <img src="https://assets.example/cart-lab/images/track-markers.png?rev=3" alt="A straight track marked every half metre."/>
        </p>
      </qti-prompt>
      <qti-simple-choice identifier="CHOICE_RATIO">Distance divided<br/>by time, as in <math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>v</mi><mo>=</mo><mfrac><mi>d</mi><mi>t</mi></mfrac></mrow><annotation encoding="application/x-tex">v = \frac{d}{t}</annotation></semantics></math></qti-simple-choice>
      <qti-simple-choice identifier="CHOICE_PRODUCT">Distance &lt;i&gt;times&lt;/i&gt; time</qti-simple-choice>
    </qti-choice-interaction>
  </qti-item-body>
  <qti-response-processing template="https://purl.imsglobal.org/spec/qti/v3p0/rptemplates/match_correct"/>
</qti-assessment-item>
